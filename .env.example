# Copy to .env and fill in. .env is gitignored; .env.example is committed.

# Claude API key for the LLM project-report review feature.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Kaggle credentials, used by student notebooks that call kagglehub.dataset_download(...).
# Get a token at https://www.kaggle.com/settings -> "Create New Token" (downloads kaggle.json).
# Anonymous downloads work for some public datasets; credentials lift rate limits and
# unlock datasets that require Kaggle ToS acceptance.
KAGGLE_USERNAME=
KAGGLE_KEY=

# Instructor token. Leave empty for localhost-only use. Set it before exposing
# the app to students (e.g. through a tunnel to port 3000): every instructor
# API route then requires it; student review links keep working without it.
INSTRUCTOR_TOKEN=

# Database. Leave unset for the local SQLite file. For Supabase, use the
# Session pooler URI (Dashboard -> Connect -> Session pooler). A hosted
# serverless API should use the Transaction pooler (port 6543) together with
# DATABASE_NULL_POOL=true.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-eu-central-1.pooler.supabase.com:5432/postgres
# DATABASE_NULL_POOL=true

# Where uploads and generated artifacts are stored: local (default) or
# supabase (a private bucket, created on first upload).
# STORAGE_BACKEND=supabase
SUPABASE_PROJECT_URL=
SUPABASE_SECRET_KEY=
# SUPABASE_STORAGE_BUCKET=course-grader

# Student accounts (Supabase Auth). Invite and reset emails link back to
# PUBLIC_APP_URL/auth/callback. SESSION_SECRET signs student login cookies
# (defaults to a key derived from SUPABASE_SECRET_KEY).
# PUBLIC_APP_URL=https://your-app.example.org
# SESSION_SECRET=
