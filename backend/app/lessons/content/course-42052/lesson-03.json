      "letter": "A",
      "title": "המודל מקבל רצף יחידות",
      "blocks": [
        {
          "type": "callout",
          "tone": "info",
          "title": "מה צריך לפני שמתחילים",
          "body": [
            "הבדל בין אימון לחיזוי"
