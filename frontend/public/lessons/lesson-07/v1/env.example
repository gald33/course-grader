# העתיקו את הקובץ הזה ל-.env (באותה תיקייה) ומלאו שם את המפתח שלכם.
# הקובץ .env רשום ב-.gitignore: הוא לא נכנס למאגר. ודאו עם git status.
# המפתח האמיתי נכתב רק ב-.env – לעולם לא כאן, לא בקוד ולא בשיחה עם הסוכן.

# המפתח מ-Google AI Studio. ריק = הדגמה ללא מודל חי (mock).
GEMINI_API_KEY=

# שם המודל (בדקו את הרשימה העדכנית בתיעוד של Google).
GEMINI_MODEL=gemini-3.5-flash-lite

# mock = תמיד הדגמה ללא מודל חי, גם אם יש מפתח. live = קריאה ל-Gemini API.
AI_MODE=live

# מתג כשל מסומן, לבדיקה בלבד: 429, 503, timeout או quota (מכסה יומית). ריק = בלי כשל.
AI_FORCE_ERROR=
